# ======================================
# HIMMEL PROJECT ENVIRONMENT VARIABLES
# ======================================
# Copy this file to .env and update values as needed.
# DO NOT commit your .env file with sensitive data!

# =====================================
# BACKEND SERVER CONFIGURATION
# =====================================
# FastAPI server host and port
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Full API URLs (derived from host/port above)
API_BASE_URL=http://127.0.0.1:8000
API_PROCESS_URL=http://127.0.0.1:8000/api/process
API_RESULT_URL=http://127.0.0.1:8000/api/result

# =====================================
# OLLAMA / AI MODEL CONFIGURATION
# =====================================
# The LLM model to use for generating responses
OLLAMA_MODEL=gemma3:4b

# Ollama server URL (if running remotely)
OLLAMA_HOST=http://localhost:11434

# =====================================
# ANDROID DEVICE CONFIGURATION
# =====================================
# Device ID for the "Server" phone (the phone that sends responses)
# Find via: adb devices
SERVER_DEVICE_ID=32001fffe8402687

# Alternative device ID for trigger_response.py 
# (if using multiple devices)
TRIGGER_DEVICE_ID=3C15B5006GX00000

# =====================================
# SMS CONFIGURATION
# =====================================
# Target phone number for direct SMS sending (app/lib/main.dart)
TARGET_PHONE_NUMBER=8595819054

# Target package for notification monitoring (Android Messages app)
TARGET_PACKAGE=com.google.android.apps.messaging

# Server app component for launching via ADB intent
SERVER_APP_COMPONENT=com.example.server_app/.MainActivity

# =====================================
# SMS CHUNKING CONFIGURATION
# =====================================
# Maximum SMS length per chunk (standard SMS limit)
MAX_SMS_LENGTH=160

# Delay between sending SMS chunks (milliseconds)
CHUNK_SEND_DELAY_MS=500

# =====================================
# MONITORING CONFIGURATION
# =====================================
# Polling interval for notification monitoring (seconds)
MONITOR_POLL_INTERVAL=2.0

# Result polling interval when waiting for AI response (seconds)
RESULT_POLL_INTERVAL=1.0

# Maximum polling attempts before timeout
MAX_POLL_ATTEMPTS=60

# =====================================
# ADB CONFIGURATION
# =====================================
# ADB command/path (use full path if not in system PATH)
ADB_CMD=adb

# =====================================
# LOGGING CONFIGURATION
# =====================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=%(asctime)s [%(levelname)s] %(message)s
